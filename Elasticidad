# 6. PROCESAMIENTO POR SKU
# ============================================================

def procesar(resumen, grupos, cfg):
    resultados = []
    validaciones = []
    predicciones = []
    prueba_todos = []
    coeficientes = []

    usar_i = bool(cfg["inventario"])

    for contador, registro in enumerate(
        resumen.to_dict("records"), 1
    ):
        if contador == 1 or contador % 20 == 0:
            print(
                f"Procesando {contador}/{len(resumen)}...",
                flush=True
            )

        g = (
            grupos[grupos["Fila"] == registro["Fila"]]
            .sort_values("Precio_promedio")
            .reset_index(drop=True)
        )

        salida = {
            **registro,
            PRINCIPAL: np.nan,
            "Elasticidad_inventario_controlando_precio": np.nan,
            "Elasticidad_conjunta_P_e_I": np.nan,
            "Modelo_utilizado": "",
            "Alpha_regularizacion": np.nan,
            "Error_estandar_elasticidad": np.nan,
            "P_value": np.nan,
            "IC95_inferior": np.nan,
            "IC95_superior": np.nan,
            "RSQ": np.nan,
            "RSQ_ajustado_aprox": np.nan,
            "RSQ_prueba_grupos": np.nan,
            "RSQ_prueba_lineal": np.nan,
            "Grupos_prueba": 0,
            "Parametros_efectivos": np.nan,
            "Condicion": np.nan,
            "Precio_referencia": np.nan,
            "Inventario_referencia": np.nan,
            "Volumen_referencia": np.nan,
            "Pendiente_precio_en_referencia": np.nan,
            "Impacto_precio_pct": np.nan,
            "Impacto_combinado_pct": np.nan,
            "Elasticidad_lineal_comparacion": np.nan,
            "P_value_lineal_comparacion": np.nan,
            "RSQ_lineal_comparacion": np.nan,
            "Metodo_inferencia": "",
            "Leverage_max": np.nan,
            "Nota": "",
            "Status": "No estimable",
        }

        if registro["Meses_validos"] < cfg["minimo_meses"]:
            salida["Nota"] = "Meses válidos insuficientes"
            resultados.append(salida)
            continue

        if len(g) < cfg["minimo_grupos_precio"]:
            salida["Nota"] = "Grupos de precio insuficientes"
            resultados.append(salida)
            continue

        p = g["Precio_promedio"].to_numpy(float)
        inventario = g["Inventario_promedio"].to_numpy(float)
        y = g["HL_promedio"].to_numpy(float)
        n = len(y)

        if usar_i and np.std(inventario) <= 1e-12:
            salida["Nota"] = "Inventario promedio constante"
            resultados.append(salida)
            continue

        if np.std(y) <= 1e-12:
            salida["Nota"] = "Volumen promedio constante"
            resultados.append(salida)
            continue

        notas = []

        try:
            # Modelo anterior sobre EXACTAMENTE los mismos grupos.
            base = ajustar(
                p, inventario, y, "lineal", 0.0, usar_i
            )
            est_base = elasticidad_referencia(
                base, cfg["bootstrap_repeticiones"],
                cfg["semilla"] + registro["Fila"]
            )

            # Reserva grupos distribuidos a lo largo del rango.
            # Es prueba entre precios, NO prueba cronológica.
            indices_test = np.arange(2, n, 5)

            hay_prueba = (
                len(indices_test) >= 3
                and n - len(indices_test) >= 5
            )

            desarrollo = np.ones(n, dtype=bool)

            if hay_prueba:
                desarrollo[indices_test] = False

            modelo, alpha, tabla_cv = seleccionar(
                p[desarrollo],
                inventario[desarrollo],
                y[desarrollo],
                cfg
            )

            tabla_cv["Fila"] = registro["Fila"]
            tabla_cv["SKU"] = registro["SKU"]
            validaciones.append(tabla_cv)

            # Prueba antes de incorporar los grupos reservados.
            if hay_prueba:
                test = ~desarrollo

                fit_train = ajustar(
                    p[desarrollo],
                    inventario[desarrollo],
                    y[desarrollo],
                    modelo, alpha, usar_i
                )

                pred_test = predecir(
                    fit_train, p[test], inventario[test]
                )

                base_train = ajustar(
                    p[desarrollo],
                    inventario[desarrollo],
                    y[desarrollo],
                    "lineal", 0.0, usar_i
                )

                pred_base_test = predecir(
                    base_train, p[test], inventario[test]
                )

                salida["RSQ_prueba_grupos"] = r2(
                    y[test], pred_test
                )
                salida["RSQ_prueba_lineal"] = r2(
                    y[test], pred_base_test
                )
                salida["Grupos_prueba"] = int(test.sum())

                for j, indice in enumerate(np.flatnonzero(test)):
                    prueba_todos.append({
                        "Fila": registro["Fila"],
                        "SKU": registro["SKU"],
                        "Precio": p[indice],
                        "Inventario": inventario[indice],
                        "HL_real": y[indice],
                        "HL_predicho_ML": pred_test[j],
                        "HL_predicho_lineal": pred_base_test[j],
                    })
            else:
                notas.append(
                    "Sin prueba reservada; validación usada para selección"
                )

            # Ajuste final con todos los grupos.
            fit = ajustar(
                p, inventario, y, modelo, alpha, usar_i
            )

            est = elasticidad_referencia(
                fit,
                cfg["bootstrap_repeticiones"],
                cfg["semilla"] + registro["Fila"]
            )

        except (ValueError, np.linalg.LinAlgError) as error:
            salida["Nota"] = str(error)
            resultados.append(salida)
            continue

        pred = predecir(fit, p, inventario)
        rsq = r2(y, pred)
        edf = fit["parametros_efectivos"]

        rsq_ajustado = (
            1 - (1 - rsq) * (n - 1) / (n - edf)
            if n > edf else np.nan
        )

        ep = est["Elasticidad"]
        ei = est["Elasticidad_I"]
        pvalue = est["P_value"]

        if np.isfinite(pvalue):
            significativa = pvalue < cfg["alpha_significancia"]
            salida["Status"] = (
                ("Negativa" if ep < 0 else "Positiva o nula")
                + (
                    " significativa"
                    if significativa else " no significativa"
                )
            )
        else:
            salida["Status"] = "Estimable; inferencia no disponible"

        p_ref = est["Precio_referencia"]
        i_ref = est["Inventario_referencia"]
        q_ref = est["Volumen_referencia"]

        nuevo_p = p_ref * (1 + cfg["cambio_precio"])
        nuevo_i = i_ref * (1 + cfg["cambio_inventario"])

        q_precio = float(predecir(
            fit, [nuevo_p], [i_ref]
        )[0])

        q_combinado = float(predecir(
            fit, [nuevo_p], [nuevo_i]
        )[0])

        impacto_p = (
            100 * (q_precio / q_ref - 1)
            if q_precio > 0 else np.nan
        )
        impacto_combinado = (
            100 * (q_combinado / q_ref - 1)
            if q_combinado > 0 else np.nan
        )

        if registro["Meses_validos"] < 12:
            notas.append("Historia menor a 12 meses")

        if n < 6:
            notas.append("Pocos grupos para inferencia")

        if fit["condicion"] > 30:
            notas.append("Colinealidad elevada")

        if est["Leverage_max"] > 0.8:
            notas.append("Algún grupo tiene influencia elevada")

        if q_precio <= 0 or q_combinado <= 0:
            notas.append(
                "Escenario predice volumen no positivo"
            )

        if nuevo_p < p.min() or nuevo_p > p.max():
            notas.append(
                "Escenario de precio fuera del rango observado"
            )

        if modelo != "lineal":
            notas.append(
                "Inferencia aproximada; condicionada a curva y alpha elegidos"
            )

        salida.update({
            PRINCIPAL: ep,
            "Elasticidad_inventario_controlando_precio": ei,
            "Elasticidad_conjunta_P_e_I": (
                ep + ei if np.isfinite(ei) else np.nan
            ),
            "Modelo_utilizado": modelo,
            "Alpha_regularizacion": alpha,
            "Error_estandar_elasticidad": est["SE"],
            "P_value": pvalue,
            "IC95_inferior": est["IC_inferior"],
            "IC95_superior": est["IC_superior"],
            "RSQ": rsq,
            "RSQ_ajustado_aprox": rsq_ajustado,
            "Parametros_efectivos": edf,
            "Condicion": fit["condicion"],
            "Precio_referencia": p_ref,
            "Inventario_referencia": i_ref,
            "Volumen_referencia": q_ref,
            "Pendiente_precio_en_referencia": est[
                "Pendiente_precio"
            ],
            "Impacto_precio_pct": impacto_p,
            "Impacto_combinado_pct": impacto_combinado,
            "Elasticidad_lineal_comparacion": est_base["Elasticidad"],
            "P_value_lineal_comparacion": est_base["P_value"],
            "RSQ_lineal_comparacion": r2(
                y, predecir(base, p, inventario)
            ),
            "Metodo_inferencia": est["Metodo_inferencia"],
            "Leverage_max": est["Leverage_max"],
            "Nota": "; ".join(notas),
        })

        resultados.append(salida)

        # Elasticidades locales en cada grupo.
        for j in range(n):
            pendiente = float(
                vector_derivada(
                    fit, p[j], inventario[j], "precio"
                ) @ fit["beta"]
            )

            predicciones.append({
                "Fila": registro["Fila"],
                "SKU": registro["SKU"],
                "Precio_grupo": g.loc[j, "Precio_grupo"],
                "Precio": p[j],
                "Inventario": inventario[j],
                "HL_real": y[j],
                "HL_estimado": pred[j],
                "Residuo_HL": y[j] - pred[j],
                "Pendiente_precio_local": pendiente,
                "Elasticidad_precio_local": (
                    pendiente * p[j] / pred[j]
                    if pred[j] > 0 else np.nan
                ),
            })

        # Coeficientes sobre bases estandarizadas:
        # en curvas no se interpretan como elasticidades.
        for j, nombre in enumerate(fit["nombres"]):
            coeficientes.append({
                "Fila": registro["Fila"],
                "SKU": registro["SKU"],
                "Modelo": modelo,
                "Termino": nombre,
                "Coeficiente_base_estandarizada": fit["beta"][j],
            })

    resultado = pd.DataFrame(resultados)

    resultado["Q_value_FDR"] = fdr_bh(
        resultado["P_value"].to_numpy()
    )

    resultado["Negativa_significativa_FDR"] = (
        (resultado[PRINCIPAL] < 0)
        & (
            resultado["Q_value_FDR"]
            < cfg["alpha_significancia"]
        )
    )

    return {
        "Elasticidades_SKU": resultado,
        "Validacion_modelos": (
            pd.concat(validaciones, ignore_index=True)
            if validaciones else pd.DataFrame()
        ),
        "Predicciones_grupos": pd.DataFrame(predicciones),
        "Prueba_grupos": pd.DataFrame(prueba_todos),
        "Coeficientes_bases": pd.DataFrame(coeficientes),
    }


# ============================================================
# 7. CONTEOS Y EXCEL
# ============================================================

def exportar(tablas, grupos, detalle, cfg):
    resultado = tablas["Elasticidades_SKU"]
    e = resultado[PRINCIPAL]
    p = resultado["P_value"]

    significativa = (
        p.notna() & (p < cfg["alpha_significancia"])
    )

    conteo = pd.DataFrame({
        "Resultado": [
            "Negativas significativas",
            "Negativas no significativas",
            "Positivas o nulas significativas",
            "Positivas o nulas no significativas",
            "Estimables sin inferencia",
            "No estimables",
            "TOTAL SKUs",
        ],
        "Cantidad": [
            int(((e < 0) & significativa).sum()),
            int(((e < 0) & p.notna() & ~significativa).sum()),
            int(((e >= 0) & significativa).sum()),
            int(((e >= 0) & p.notna() & ~significativa).sum()),
            int((e.notna() & p.isna()).sum()),
            int(e.isna().sum()),
            len(resultado),
        ],
    })

    modelos = (
        resultado.loc[e.notna(), "Modelo_utilizado"]
        .value_counts()
        .rename_axis("Modelo")
        .reset_index(name="SKUs")
    )

    motivos = (
        resultado.loc[e.isna(), "Nota"]
        .value_counts()
        .rename_axis("Motivo")
        .reset_index(name="SKUs")
    )

    metodologia = pd.DataFrame([
        (
            "Elasticidad principal",
            PRINCIPAL
        ),
        (
            "Definición",
            "Pendiente local de Q respecto a P, multiplicada por "
            "P_referencia/Q_predicho_referencia. Inventario fijo."
        ),
        (
            "Referencia",
            "Precio e inventario promedio de los grupos. "
            "En OLS con intercepto, Q_predicho en esa referencia "
            "coincide con Q promedio."
        ),
        (
            "Preparación",
            "Q desestacionalizado del Excel. "
            "Precio = revenue/HL originales. "
            "Promedios por precio redondeado; igual peso por grupo."
        ),
        (
            "Lineal",
            "Reproduce Q = a + b*P + c*I sobre los grupos. "
            "Elasticidad = b*P_referencia/Q_referencia."
        ),
        (
            "Curvas",
            "Modelo aditivo con splines cuadráticos regularizados. "
            "No incluye interacción precio-inventario."
        ),
        (
            "Selección",
            "Validación dejando fuera grupos de precio. "
            "Se recalculan transformaciones con cada entrenamiento. "
            "Se prefiere menor complejidad con error comparable."
        ),
        (
            "Prueba",
            "Grupos de precio reservados y no usados para selección. "
            "No es prueba temporal ni valida causalidad."
        ),
        (
            "P-value lineal",
            "Prueba t OLS convencional de pendiente cero. "
            "Supone errores independientes y homocedásticos entre grupos."
        ),
        (
            "P-value curvas",
            "Prueba Wald normal con SE de wild bootstrap condicional. "
            "Referencias y regularización fijas. "
            "No corrige toda la incertidumbre de selección "
            "ni el sesgo de regularización."
        ),
        (
            "Intervalos",
            "Intervalos de la pendiente local convertidos a elasticidad "
            "con referencias fijas. No son intervalos de predicción."
        ),
        (
            "Dependencia",
            "La agrupación no garantiza independencia de los errores. "
            "No se aplica HAC temporal sobre grupos ordenados por precio."
        ),
        (
            "R2",
            "Calculado sobre HL promedio por grupo, no logaritmos. "
            "R2 ajustado es convencional en lineal y aproximado "
            "con grados de libertad efectivos en curvas."
        ),
        (
            "FDR",
            "Benjamini-Hochberg para muchos SKUs; hereda las "
            "limitaciones de los p-values."
        ),
        (
            "Elasticidad conjunta",
            "Suma local precio + inventario: dirección donde ambos "
            "cambian en el mismo porcentaje. No se usa para el conteo."
        ),
        (
            "Escenarios",
            "Reevalúa la curva al nuevo precio/inventario. "
            "El efecto de un cambio grande no es necesariamente "
            "elasticidad local multiplicada por ese porcentaje."
        ),
        (
            "Coeficientes de bases",
            "Son coeficientes de variables estandarizadas. "
            "En splines, un coeficiente de base no es una elasticidad."
        ),
        (
            "Alcance",
            "Asociación condicionada al modelo y datos disponibles. "
            "No elimina crecimiento por lanzamiento ni demuestra "
            "causalidad. No selecciona por signo."
        ),
    ], columns=["Tema", "Descripción"])

    configuracion = pd.DataFrame([
        {"Parámetro": k, "Valor": str(v)}
        for k, v in cfg.items()
    ])

    hojas = {
        "Conteo": conteo,
        **tablas,
        "Modelos_utilizados": modelos,
        "Motivos_no_estimables": motivos,
        "Promedios_por_precio": grupos,
        "Detalle_mensual": detalle,
        "Metodologia": metodologia,
        "Configuracion": configuracion,
    }

    with pd.ExcelWriter(
        cfg["archivo_salida"],
        engine="openpyxl",
        datetime_format="yyyy-mm-dd"
    ) as writer:
        for nombre, tabla in hojas.items():
            tabla.replace(
                [np.inf, -np.inf], np.nan
            ).to_excel(
                writer, sheet_name=nombre, index=False
            )

            ws = writer.sheets[nombre]
            ws.freeze_panes = "A2"

            if len(tabla.columns):
                ws.auto_filter.ref = ws.dimensions

            ws.row_dimensions[1].height = 48

            for celda in ws[1]:
                celda.font = Font(
                    bold=True, color="FFFFFF"
                )
                celda.fill = PatternFill(
                    "solid", fgColor="17365D"
                )
                celda.alignment = Alignment(
                    wrap_text=True, vertical="center"
                )

            for columna in ws.columns:
                encabezado = str(columna[0].value or "")

                ws.column_dimensions[
                    columna[0].column_letter
                ].width = (
                    65 if encabezado in (
                        "Producto", "Nota", "Descripción"
                    )
                    else min(42, max(16, len(encabezado) + 2))
                )

                for celda in columna[1:]:
                    if isinstance(celda.value, float):
                        celda.number_format = (
                            "0.0000E+00"
                            if "value" in encabezado
                            else "0.0000"
                        )

    return conteo, modelos, motivos


