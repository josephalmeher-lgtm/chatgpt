def numero(v):
    if isinstance(v, (bool, np.bool_)):
        return np.nan
    if isinstance(v, (int, float, np.integer, np.floating)):
        return float(v) if np.isfinite(v) else np.nan
    return np.nan


def r2(y, pred):
    y = np.asarray(y, float)
    pred = np.asarray(pred, float)

    sst = float(np.sum((y - y.mean()) ** 2))

    if len(y) < 2 or sst <= 1e-12:
        return np.nan

    return float(1 - np.sum((y - pred) ** 2) / sst)


# ============================================================
# 2. EXCEL: MISMA PREPARACIÓN QUE LA REGRESIÓN ANTERIOR
# ============================================================

def leer_excel(ruta, cfg):
    fechas = pd.date_range(
        cfg["inicio"], periods=cfg["numero_meses"], freq="MS"
    )

    bloques = {
        "original": col(cfg["volumen_original"]),
        "Q": col(cfg["volumen_desestacionalizado"]),
        "Revenue": col(cfg["revenue"]),
    }

    if cfg["inventario"]:
        bloques["I"] = col(cfg["inventario"])

    c_producto = col(cfg["producto"])
    c_sku = col(cfg["sku"]) if cfg["sku"] else None

    ultima_col = max(
        [c + cfg["numero_meses"] - 1 for c in bloques.values()]
        + [c_producto]
        + ([c_sku] if c_sku else [])
    )

    resumen = []
    grupos_todos = []
    detalle_todos = []

    libro = load_workbook(
        ruta, read_only=True, data_only=True
    )

    try:
        if cfg["hoja"] not in libro.sheetnames:
            raise ValueError(
                f"No existe {cfg['hoja']!r}. "
                f"Disponibles: {libro.sheetnames}"
            )

        ws = libro[cfg["hoja"]]

        encabezados = next(ws.iter_rows(
            min_row=cfg["fila_fechas"],
            max_row=cfg["fila_fechas"],
            max_col=ultima_col,
            values_only=True
        ))

        for nombre, inicio_col in bloques.items():
            for j, fecha in enumerate(fechas):
                valor = encabezados[inicio_col - 1 + j]

                if not (
                    hasattr(valor, "year")
                    and hasattr(valor, "month")
                ):
                    raise ValueError(
                        f"Fecha no reconocida: bloque {nombre}, "
                        f"posición {j + 1}."
                    )

                if (
                    pd.Timestamp(valor).to_period("M")
                    != fecha.to_period("M")
                ):
                    raise ValueError(
                        f"Bloque {nombre} desalineado "
                        f"en el mes {j + 1}."
                    )

        filas = ws.iter_rows(
            min_row=cfg["primera_fila"],
            max_row=cfg["ultima_fila"] or ws.max_row,
            max_col=ultima_col,
            values_only=True
        )

        for fila, valores in enumerate(
            filas, cfg["primera_fila"]
        ):
            producto = valores[c_producto - 1]

            if producto is None or not str(producto).strip():
                continue

            sku = (
                valores[c_sku - 1]
                if c_sku else fila - cfg["primera_fila"]
            )

            if sku is None or not str(sku).strip():
                continue

            series = {
                nombre: np.array([
                    numero(valores[inicio_col - 1 + j])
                    for j in range(cfg["numero_meses"])
                ])
                for nombre, inicio_col in bloques.items()
            }

            original = series["original"]
            q = series["Q"]
            revenue = series["Revenue"]
            inventario = series.get(
                "I", np.zeros(cfg["numero_meses"])
            )

            p = np.full(cfg["numero_meses"], np.nan)

            np.divide(
                revenue, original, out=p,
                where=np.isfinite(original) & (original > 0)
            )

            ventas_validas = (
                np.isfinite(original) & (original > 0)
                & np.isfinite(q) & (q > 0)
                & np.isfinite(revenue) & (revenue > 0)
                & np.isfinite(p) & (p > 0)
            )

            inventario_valido = (
                np.isfinite(inventario) & (inventario >= 0)
            )

            validos = ventas_validas & inventario_valido

            motivos = np.full(
                cfg["numero_meses"], "Utilizado", dtype=object
            )
            motivos[~ventas_validas] = (
                "Volumen/precio/revenue cero, faltante o inválido"
            )
            motivos[ventas_validas & ~inventario_valido] = (
                "Inventario faltante o inválido"
            )

            detalle = pd.DataFrame({
                "Fila": fila,
                "SKU": sku,
                "Producto": str(producto).strip(),
                "Fecha": fechas,
                "HL_originales": original,
                "HL_desestacionalizados": q,
                "Revenue": revenue,
                "Precio_por_HL": p,
                "Inventario": inventario,
                "Utilizado": validos,
                "Motivo": motivos,
            })

            detalle["Precio_grupo"] = np.nan
            detalle.loc[validos, "Precio_grupo"] = np.round(
                p[validos], cfg["decimales_precio"]
            )

            grupos = (
                detalle.loc[validos]
                .groupby("Precio_grupo", as_index=False)
                .agg(
                    Precio_promedio=("Precio_por_HL", "mean"),
                    HL_promedio=("HL_desestacionalizados", "mean"),
                    Inventario_promedio=("Inventario", "mean"),
                    Meses_en_grupo=("Fecha", "size"),
                    Primera_fecha=("Fecha", "min"),
                    Ultima_fecha=("Fecha", "max"),
                )
                .sort_values("Precio_promedio")
                .reset_index(drop=True)
            )

            grupos.insert(0, "Producto", str(producto).strip())
            grupos.insert(0, "SKU", sku)
            grupos.insert(0, "Fila", fila)

            resumen.append({
                "Fila": fila,
                "SKU": sku,
                "Producto": str(producto).strip(),
                "Meses_validos": int(validos.sum()),
                "Meses_excluidos": int((~validos).sum()),
                "Meses_perdidos_por_inventario": int(
                    (ventas_validas & ~inventario_valido).sum()
                ),
                "N_grupos_precio": len(grupos),
            })

            grupos_todos.append(grupos)
            detalle_todos.append(detalle)

    finally:
        libro.close()

    if not resumen:
        raise ValueError("No se encontraron productos.")

    return (
        pd.DataFrame(resumen),
        pd.concat(grupos_todos, ignore_index=True),
        pd.concat(detalle_todos, ignore_index=True)
    )


# ============================================================
# 3. MODELOS LINEALES Y CURVAS REGULARIZADAS
# ============================================================

def ajustar(p, inventario, y, modelo, alpha, usar_inventario):
    p = np.asarray(p, float)
    inventario = np.asarray(inventario, float)
    y = np.asarray(y, float)

    transformadores = []
    matrices = []
    nombres = []

    variables = [
        ("Precio", p, modelo != "lineal")
    ]

    if usar_inventario:
        variables.append((
            "Inventario",
            inventario,
            modelo == "curvas_PI"
        ))

    for nombre, valores, curva in variables:
        if curva:
            transformador = SplineTransformer(
                n_knots=3,
                degree=2,
                include_bias=False,
                extrapolation="linear"
            ).fit(valores.reshape(-1, 1))

            A = transformador.transform(
                valores.reshape(-1, 1)
            )

            nombres.extend([
                f"{nombre}_base_{j + 1}"
                for j in range(A.shape[1])
            ])

        else:
            transformador = None
            A = valores.reshape(-1, 1)
            nombres.append(nombre)

        transformadores.append(transformador)
        matrices.append(A)

    A = np.column_stack(matrices)
    media = A.mean(axis=0)
    escala = A.std(axis=0)

    if np.any(escala <= 1e-12):
        raise ValueError("Variable explicativa constante")

    X = np.column_stack([
        np.ones(len(y)),
        (A - media) / escala
    ])

    n, k = X.shape

    if n <= k:
        raise ValueError("Grados de libertad insuficientes")

    if np.linalg.matrix_rank(X) < k:
        raise ValueError("Variables exactamente dependientes")

    # No penaliza el intercepto.
    penalizacion = np.diag(
        [0.0] + [alpha * n] * (k - 1)
    )

    M = np.linalg.solve(
        X.T @ X + penalizacion,
        X.T
    )

    beta = M @ y
    H = X @ M

    return {
        "modelo": modelo,
        "alpha": alpha,
        "usar_inventario": usar_inventario,
        "transformadores": transformadores,
        "media": media,
        "escala": escala,
        "nombres": ["Intercepto"] + nombres,
        "X": X,
        "M": M,
        "beta": beta,
        "H": H,
        "p": p,
        "i": inventario,
        "y": y,
        "parametros_efectivos": float(np.trace(H)),
        "condicion": float(np.linalg.cond(X)),
    }


def matriz_prediccion(fit, p, inventario):
    p = np.atleast_1d(np.asarray(p, float))
    inventario = np.atleast_1d(
        np.asarray(inventario, float)
    )

    valores = [p]
    if fit["usar_inventario"]:
        valores.append(inventario)

    matrices = []

    for variable, transformador in zip(
        valores, fit["transformadores"]
    ):
        A = (
            transformador.transform(variable.reshape(-1, 1))
            if transformador is not None
            else variable.reshape(-1, 1)
        )
        matrices.append(A)

    A = np.column_stack(matrices)

    return np.column_stack([
        np.ones(len(A)),
        (A - fit["media"]) / fit["escala"]
    ])


def predecir(fit, p, inventario):
    return (
        matriz_prediccion(fit, p, inventario)
        @ fit["beta"]
    )


def vector_derivada(fit, p, inventario, variable):
    if variable == "inventario" and not fit["usar_inventario"]:
        return np.zeros(len(fit["beta"]))

    referencia = p if variable == "precio" else inventario
    serie = fit["p"] if variable == "precio" else fit["i"]

    paso = max(
        abs(referencia) * 1e-4,
        np.ptp(serie) * 1e-5,
        1e-7
    )

    inferior = max(0.0, referencia - paso)
    superior = referencia + paso

    if variable == "precio":
        arriba = matriz_prediccion(
            fit, [superior], [inventario]
        )[0]
        abajo = matriz_prediccion(
            fit, [inferior], [inventario]
        )[0]
    else:
        arriba = matriz_prediccion(
            fit, [p], [superior]
        )[0]
        abajo = matriz_prediccion(
            fit, [p], [inferior]
        )[0]

    return (arriba - abajo) / (superior - inferior)


# ============================================================
# 4. SELECCIÓN POR VALIDACIÓN DE GRUPOS DE PRECIO
# ============================================================

def candidatos(n, cfg):
    modelos = [("lineal", 0.0)]

    if n >= cfg["minimo_grupos_curva_precio"]:
        modelos.extend([
            ("curva_P", alpha)
            for alpha in cfg["alphas"]
        ])

    if (
        cfg["inventario"]
        and n >= cfg["minimo_grupos_curvas_PI"]
    ):
        modelos.extend([
            ("curvas_PI", alpha)
            for alpha in cfg["alphas"]
        ])

    return modelos


def seleccionar(p, inventario, y, cfg):
    n = len(y)
    evaluaciones = []
    usar_i = bool(cfg["inventario"])

    for modelo, alpha in candidatos(n, cfg):
        errores = []

        try:
            completo = ajustar(
                p, inventario, y, modelo, alpha, usar_i
            )

            # Cada grupo queda fuera una vez.
            # Escalas y splines se recalculan sin ese grupo.
            for j in range(n):
                mantener = np.arange(n) != j

                fit = ajustar(
                    p[mantener],
                    inventario[mantener],
                    y[mantener],
                    modelo,
                    alpha,
                    usar_i
                )

                estimado = float(predecir(
                    fit, [p[j]], [inventario[j]]
                )[0])

                errores.append((y[j] - estimado) ** 2)

        except (ValueError, np.linalg.LinAlgError):
            continue

        evaluaciones.append({
            "Modelo": modelo,
            "Alpha": alpha,
            "MSE_validacion": float(np.mean(errores)),
            "SE_MSE": float(
                np.std(errores, ddof=1) / np.sqrt(n)
            ),
            "Parametros_efectivos": completo[
                "parametros_efectivos"
            ],
        })

    if not evaluaciones:
        raise ValueError("No fue posible validar el modelo")

    tabla = pd.DataFrame(evaluaciones)
    mejor = tabla.loc[tabla["MSE_validacion"].idxmin()]

    # Preferencia por menor complejidad si los errores
    # están dentro de un error estándar del mejor.
    limite = mejor["MSE_validacion"] + mejor["SE_MSE"]

    elegibles = tabla[
        tabla["MSE_validacion"] <= limite
    ]

    elegido = (
        elegibles
        .sort_values(["Parametros_efectivos", "MSE_validacion"])
        .iloc[0]
    )

    tabla["Elegido"] = (
        (tabla["Modelo"] == elegido["Modelo"])
        & (tabla["Alpha"] == elegido["Alpha"])
    )

    return (
        elegido["Modelo"],
        float(elegido["Alpha"]),
        tabla
    )


# ============================================================
# 5. ELASTICIDAD E INFERENCIA
# ============================================================

def elasticidad_referencia(fit, repeticiones, semilla):
    p_ref = float(fit["p"].mean())
    i_ref = float(fit["i"].mean())

    # En OLS con intercepto, esta predicción coincide
    # con el volumen promedio de los grupos.
    q_ref = float(predecir(
        fit, [p_ref], [i_ref]
    )[0])

    if not np.isfinite(q_ref) or q_ref <= 0:
        raise ValueError(
            "Predicción de referencia no positiva; "
            "elasticidad no interpretable"
        )

    dp_vector = vector_derivada(
        fit, p_ref, i_ref, "precio"
    )
    di_vector = vector_derivada(
        fit, p_ref, i_ref, "inventario"
    )

    pendiente_p = float(dp_vector @ fit["beta"])
    pendiente_i = float(di_vector @ fit["beta"])

    ep = pendiente_p * p_ref / q_ref
    ei = (
        pendiente_i * i_ref / q_ref
        if fit["usar_inventario"] else np.nan
    )

    residuos = fit["y"] - fit["X"] @ fit["beta"]
    n, k = fit["X"].shape
    leverage = np.diag(fit["H"])

    if fit["modelo"] == "lineal":
        gl = n - k

        cov = (
            float(residuos @ residuos) / gl
            * np.linalg.inv(fit["X"].T @ fit["X"])
        )

        se_pendiente = np.sqrt(max(
            float(dp_vector @ cov @ dp_vector), 0.0
        ))

        se_elasticidad = se_pendiente * p_ref / q_ref

        pvalue = (
            float(2 * student_t.sf(
                abs(ep / se_elasticidad), gl
            ))
            if se_elasticidad > 1e-12 else np.nan
        )

        critico = float(student_t.ppf(0.975, gl))
        metodo = "t OLS clásico; referencias fijas"

    else:
        # Wild bootstrap con diseño y regularización fijos.
        # Mantiene referencias P, I y Q fijas para la inferencia
        # de la pendiente local, como la conversión del OLS.
        rng = np.random.default_rng(semilla)

        residuos_ajustados = residuos / np.sqrt(
            np.maximum(1 - leverage, 0.05)
        )

        pesos = rng.choice(
            [-1.0, 1.0],
            size=(n, repeticiones)
        )

        y_bootstrap = (
            (fit["X"] @ fit["beta"])[:, None]
            + residuos_ajustados[:, None] * pesos
        )

        betas_bootstrap = fit["M"] @ y_bootstrap
        pendientes_bootstrap = dp_vector @ betas_bootstrap

        se_pendiente = float(np.std(
            pendientes_bootstrap, ddof=1
        ))

        se_elasticidad = se_pendiente * p_ref / q_ref

        pvalue = (
            float(2 * norm.sf(abs(ep / se_elasticidad)))
            if se_elasticidad > 1e-12 else np.nan
        )

        critico = 1.96
        metodo = (
            "Wald normal con SE wild bootstrap; "
            "modelo y referencias fijos"
        )

    return {
        "Elasticidad": ep,
        "Elasticidad_I": ei,
        "SE": float(se_elasticidad),
        "P_value": pvalue,
        "IC_inferior": ep - critico * se_elasticidad,
        "IC_superior": ep + critico * se_elasticidad,
        "Precio_referencia": p_ref,
        "Inventario_referencia": i_ref,
        "Volumen_referencia": q_ref,
        "Pendiente_precio": pendiente_p,
        "Pendiente_inventario": pendiente_i,
        "Metodo_inferencia": metodo,
        "Leverage_max": float(leverage.max()),
    }


def fdr_bh(pvalues):
    p = np.asarray(pvalues, float)
    q = np.full(len(p), np.nan)
    validos = np.flatnonzero(np.isfinite(p))

    if len(validos):
        orden = validos[np.argsort(p[validos])]
        ajustes = (
            p[orden] * len(orden)
            / np.arange(1, len(orden) + 1)
        )
        q[orden] = np.minimum(
            1,
            np.minimum.accumulate(ajustes[::-1])[::-1]
        )

    return q


